// A placeholder, so a fresh clone or a CI runner builds unsigned. Set your own
// team and identifier in DevelopmentTeam.xcconfig, which is gitignored.
DEVELOPMENT_TEAM =
MNEME_APP_ID = org.example.mneme
PRODUCT_BUNDLE_IDENTIFIER = $(MNEME_APP_ID)

// Build numbers carry on from the Jellyfin app's TestFlight builds, which
// share the bundle identifier.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 10

#include? "DevelopmentTeam.xcconfig"
